<?xml version="1.0" encoding="utf-8" ?>
<DataTemplate
    x:Class="Mio.CollectionModels.ProjectTactileTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Mio.Models"
    x:DataType="models:ProjectModel">
    <Button
        Padding="16"
        Clicked="ProjectSelectionChanged"
        Style="{x:StaticResource TactileButton}"
        Text="{x:Binding Title}" />
</DataTemplate>
