<?xml version="1.0" encoding="utf-8" ?>
<CollectionView
    x:Class="Mio.Widgets.GalleryWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:collectionmodels="clr-namespace:Mio.CollectionModels"
    x:Name="ItemsCollection"
    HorizontalScrollBarVisibility="Never"
    SelectionChanged="ProjectSelectionChanged"
    SelectionMode="Single">

    <CollectionView.ItemTemplate>
        <collectionmodels:ProjectGalleryTemplate />
    </CollectionView.ItemTemplate>

    <!--<CollectionView.EmptyView>
        <collectionmodels:EmptyCollectionTemplate />
    </CollectionView.EmptyView>-->

    <CollectionView.ItemsLayout>
        <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
    </CollectionView.ItemsLayout>

</CollectionView>
