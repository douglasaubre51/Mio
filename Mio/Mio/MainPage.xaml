<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mio.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Mio.Models"
    xmlns:pagemodels="clr-namespace:Mio.PageModels"
    xmlns:templates="clr-namespace:Mio.CollectionModels"
    xmlns:widgets="clr-namespace:Mio.Widgets"
    x:DataType="pagemodels:MainPageModel"
    Shell.NavBarIsVisible="True">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{x:Binding RefreshingCommand}" IconImageSource="refresh_24dp.png" />
    </ContentPage.ToolbarItems>

    <CollectionView Margin="16" ItemsSource="{x:Binding ReleasedProjects}">
        <CollectionView.Header>
            <Grid Margin="0,16" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <!--  Ongoing projects section  -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Row="0">
                        <Label
                            HorizontalOptions="Start"
                            Style="{x:StaticResource SectionTitle}"
                            Text="Ongoing projects" />

                        <!--  spinner  -->
                        <ActivityIndicator
                            Margin="16,0,0,0"
                            IsRunning="{x:Binding IsProjectCollectionRefreshing}"
                            IsVisible="{x:Binding IsProjectCollectionRefreshing}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button
                        Grid.Column="2"
                        Command="{x:Binding GoToMoreOngoingProjectsCommand}"
                        HorizontalOptions="End"
                        Style="{x:StaticResource ExtraButton}"
                        Text="More" />
                </Grid>

                <widgets:GalleryWidget
                    Grid.Row="1"
                    Margin="0,0,0,32"
                    ItemsSource="{x:Binding OngoingProjects}" />

                <!--  Find projects section  -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Row="0">
                        <Label
                            HorizontalOptions="Start"
                            Style="{x:StaticResource SectionTitle}"
                            Text="Find new project" />

                        <!--  spinner  -->
                        <ActivityIndicator
                            Margin="16,0,0,0"
                            IsRunning="{x:Binding IsProjectCollectionRefreshing}"
                            IsVisible="{x:Binding IsProjectCollectionRefreshing}"
                            VerticalOptions="Start" />
                    </HorizontalStackLayout>

                    <Button
                        Grid.Column="2"
                        Command="{x:Binding GoToFindMoreProjectsCommand}"
                        HorizontalOptions="End"
                        Style="{x:StaticResource ExtraButton}"
                        Text="More" />
                </Grid>

                <widgets:GalleryWidget
                    Grid.Row="3"
                    Margin="0,0,0,32"
                    ItemsSource="{x:Binding FreshProjects}" />

                <Grid Grid.Row="4" ColumnDefinitions="Auto,*">
                    <Label
                        Grid.Row="0"
                        Style="{x:StaticResource SectionTitle}"
                        Text="Released projects" />

                    <Button
                        Grid.Column="1"
                        Command="{x:Binding GoToMoreReleasedProjectsCommand}"
                        HorizontalOptions="End"
                        Style="{x:StaticResource ExtraButton}"
                        Text="More" />
                </Grid>
            </Grid>
        </CollectionView.Header>

        <!--  Released projects section !  -->
        <CollectionView.ItemTemplate>
            <templates:ProjectTactileTemplate />
        </CollectionView.ItemTemplate>

        <CollectionView.ItemsLayout>
            <GridItemsLayout
                HorizontalItemSpacing="8"
                Orientation="Vertical"
                Span="{x:OnPlatform Android=1,
                                    WinUI=4}"
                VerticalItemSpacing="8" />
        </CollectionView.ItemsLayout>
    </CollectionView>
</ContentPage>
